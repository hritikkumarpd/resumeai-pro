# ═══════════════════════════════════════════════
# ResumeAI Pro — Server Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Server ──────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────
# Get from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ──────────────────────────────────────────
# Supabase JWT secret: Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Razorpay ─────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ── Resend (Email) ────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@resumeaipro.com

# ── Admin ─────────────────────────────────────────
ADMIN_SECRET=your-super-secret-admin-key-change-this
