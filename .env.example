# ═══════════════════════════════════════════════
# ResumeAI Pro — Frontend Environment Variables
# Copy to .env and fill in your Supabase values
# ═══════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────
# Get from: supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── API Server (Express on Render/Railway) ────────
# Development: http://localhost:4000
# Production:  https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000

# ── App ──────────────────────────────────────────
VITE_APP_NAME=ResumeAI Pro
VITE_APP_URL=http://localhost:5173

# ── Google Gemini AI (100% Free - https://aistudio.google.com/app/apikey) ──
VITE_GEMINI_API_KEY=

# ── Razorpay (Key ID only — secret stays on server) ──
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
